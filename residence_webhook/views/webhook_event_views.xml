
<odoo>

    <!-- Tree View -->
    <record id="view_residence_webhook_event_tree" model="ir.ui.view">
        <field name="name">residence.webhook.event.tree</field>
        <field name="model">residence.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Webhook Events">
                <field name="event_id"/>
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <field name="state"/>
                <field name="retry_count"/>
                <field name="next_retry"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_residence_webhook_event_form" model="ir.ui.view">
        <field name="name">residence.webhook.event.form</field>
        <field name="model">residence.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Webhook Event">
                <sheet>
                    <group>
                        <field name="event_id"/>
                        <field name="event_type"/>
                        <field name="entity_type"/>
                        <field name="entity_id"/>
                        <field name="state"/>
                    </group>

                    <group>
                        <field name="retry_count"/>
                        <field name="next_retry"/>
                        <field name="last_error"/>
                    </group>

                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_residence_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">residence.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_residence_webhook_root"
              name="Residence Webhooks"
              sequence="100"/>

    <menuitem id="menu_residence_webhook_events"
              name="Webhook Events"
              parent="menu_residence_webhook_root"
              action="action_residence_webhook_event"/>
</odoo>
