<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire produit : afficher coût TTC juste après standard_price -->
    <record id="product_template_form_inherit_cost_ttc" model="ir.ui.view">
        <field name="name">product.template.form.cost.ttc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="x_cost_ttc"
                       string="Coût TTC (18%)"
                       readonly="1"
                       invisible="standard_price == 0"/>
            </xpath>
        </field>
    </record>

    <!-- Liste produits : colonne coût TTC optionnelle -->
    <record id="product_template_list_inherit_cost_ttc" model="ir.ui.view">
        <field name="name">product.template.list.cost.ttc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="x_cost_ttc"
                       string="Coût TTC (18%)"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Action serveur : recalculer en masse (menu Action de la liste) -->
    <record id="action_apply_tva_to_cost" model="ir.actions.server">
        <field name="name">Appliquer TVA 18% au coût (HT → TTC)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_apply_tva_to_cost()
        </field>
    </record>

</odoo>
