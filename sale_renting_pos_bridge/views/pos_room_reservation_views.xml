<odoo>
    <record id="view_pos_room_reservation_tree" model="ir.ui.view">
        <field name="name">pos.room.reservation.tree</field>
        <field name="model">pos.room.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="floor_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pos_room_reservation_form" model="ir.ui.view">
        <field name="name">pos.room.reservation.form</field>
        <field name="model">pos.room.reservation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="sale_order_id"/>
                        <field name="floor_id"/>
                        <field name="table_ids"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="state"/>
                    </group>
                    <footer>
                        <button name="action_done" type="object" string="Terminer"/>
                        <button name="action_cancel" type="object" string="Annuler"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
