<odoo>
    <record id="restaurant_floor_form_inherit" model="ir.ui.view">
        <field name="name">restaurant.floor.form.inherit</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="product_template_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
