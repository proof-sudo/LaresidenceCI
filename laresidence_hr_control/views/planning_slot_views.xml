<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Une seule extension suffit. La bulle qui s'ouvre au clic sur un
         créneau du gantt — planning_view_form_in_gantt — est une variante de
         cette même fiche : elle en reprend l'arborescence complète, extensions
         comprises. L'étendre une seconde fois échouait, puisqu'elle ne
         contient pas de <sheet> à elle. -->
    <record id="planning_slot_form_ecart" model="ir.ui.view">
        <field name="name">planning.slot.form.laresidence.ecart</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <!-- Odoo 19 : le champ s'appelle group_ids sur les vues, plus groups_id. -->
        <field name="group_ids" eval="[(4, ref('planning.group_planning_user'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Présence constatée"
                       invisible="not laresidence_ecart">
                    <field name="laresidence_ecart" readonly="1" nolabel="1"/>
                    <field name="laresidence_ecart_state" invisible="1"/>
                    <field name="laresidence_exception_count" invisible="1"/>
                    <button name="action_laresidence_voir_ecarts" type="object"
                            string="Voir le détail" class="btn-link"
                            invisible="laresidence_exception_count == 0"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
