<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fiche du créneau ouverte depuis le planning : c'est là que le
         gestionnaire clique, c'est donc là que le constat doit apparaître. -->
    <record id="planning_slot_form_ecart" model="ir.ui.view">
        <field name="name">planning.slot.form.laresidence.ecart</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="groups_id" eval="[(4, ref('planning.group_planning_user'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Présence constatée"
                       invisible="not laresidence_ecart">
                    <field name="laresidence_ecart" readonly="1"/>
                    <field name="laresidence_ecart_state" invisible="1"/>
                    <field name="laresidence_exception_count" invisible="1"/>
                    <button name="action_laresidence_voir_ecarts" type="object"
                            string="Voir le détail" class="btn-link"
                            invisible="laresidence_exception_count == 0"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Même chose dans la bulle qui s'ouvre au clic sur un créneau du gantt. -->
    <record id="planning_slot_form_gantt_ecart" model="ir.ui.view">
        <field name="name">planning.slot.form.in.gantt.laresidence.ecart</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form_in_gantt"/>
        <field name="groups_id" eval="[(4, ref('planning.group_planning_user'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group invisible="not laresidence_ecart">
                    <field name="laresidence_ecart" string="Présence constatée" readonly="1"/>
                    <field name="laresidence_exception_count" invisible="1"/>
                    <button name="action_laresidence_voir_ecarts" type="object"
                            string="Voir le détail" class="btn-link"
                            invisible="laresidence_exception_count == 0"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
