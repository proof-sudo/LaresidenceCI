    <!-- Action -->
    <record id="action_webhook_config" model="ir.actions.act_window">
        <field name="name">Configuration Webhooks</field>
        <field name="res_model">webhook.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier webhook
            </p>
            <p>
                Les webhooks permettent d'envoyer automatiquement des notifications HTTP
                lors des opérations de création, modification ou suppression sur vos modèles Odoo.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_webhook_root"
              name="Webhooks"
              sequence="100"
              web_icon="webhook,static/description/icon.png"
              groups="base.group_system"/>
    
    <menuitem id="menu_webhook_config"
              name="Configuration"
              parent="menu_webhook_root"
              action="action_webhook_config"
              sequence="10"/>

</odoo>