<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue list -->
    <record id="view_webhook_config_list" model="ir.ui.view">
        <field name="name">webhook.config.list</field>
        <field name="model">webhook.config</field>
        <field name="arch" type="xml">
            <list string="Webhooks">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="url"/>
                <field name="listen_create" widget="boolean_toggle"/>
                <field name="listen_write" widget="boolean_toggle"/>
                <field name="listen_unlink" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vue Form -->
    <record id="view_webhook_config_form" model="ir.ui.view">
        <field name="name">webhook.config.form</field>
        <field name="model">webhook.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Webhook">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    </div>
                    
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name" placeholder="ex: Webhook Produits vers API externe"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="url" placeholder="https://api.exemple.com/webhook"/>
                            <field name="api_key" password="True" placeholder="Clé Bearer (optionnel)"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                    
                    <group string="Événements à écouter">
                        <group>
                            <field name="listen_create"/>
                            <field name="listen_write"/>
                        </group>
                        <group>
                            <field name="listen_unlink"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Documentation">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <h4>Format du webhook envoyé:</h4>
                                    <pre>{
    "event": "create|write|unlink",
    "model": "nom.du.modele",
    "timestamp": "2024-02-07T10:30:00",
    "data": {
        "id": 123,
        "name": "...",
        ...
    },
    "changed_fields": {  // Uniquement pour 'write'
        "field_name": {
            "value": "nouvelle_valeur",
            "type": "char"
        },
        "many2one_field": {
            "old": 5,
            "new": 10,
            "type": "many2one"
        },
        "many2many_field": {
            "old": [1, 2, 3],
            "new": [1, 2, 3, 4],
            "type": "many2many"
        }
    },
    "webhook_config": {
        "id": 1,
        "name": "Mon Webhook"
    }
}</pre>
                                    <h4>Headers HTTP envoyés:</h4>
                                    <pre>Content-Type: application/json
Authorization: Bearer VOTRE_CLE_API  // Si configurée</pre>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

