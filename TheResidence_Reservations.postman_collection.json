{
  "info": {
    "name": "The Residence — Réservations API",
    "description": "Collection complète pour tester le workflow des réservations depuis l'API REST.\n\nVariables requises :\n- `base_url` : https://proof-sudo-laresidenceci.odoo.com/v1/external\n- `api_key`  : votre clé API\n\nWorkflow recommandé :\n1. Lancer '0. Setup' pour récupérer memberId et spaceId réels\n2. Exécuter les scénarios dans l'ordre",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://proof-sudo-laresidenceci.odoo.com/v1/external" },
    { "key": "api_key",  "value": "tr_4m6-Ph-gfjCgyml0qgzTWzsFKNjjLKBg6hlurE0tzgE" },
    { "key": "member_id", "value": "" },
    { "key": "space_id",  "value": "" },
    { "key": "reservation_id", "value": "" },
    { "key": "reservation_pending_id", "value": "" },
    { "key": "reservation_approved_id", "value": "" },
    { "key": "option_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup — Récupérer IDs réels",
      "description": "Étape préalable : récupère les UUIDs d'un membre et d'un espace existants, puis remplace les variables de collection.",
      "item": [
        {
          "name": "0.1 — Lister les membres (prendre le 1er)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/members?page=0&size=5",
              "host": ["{{base_url}}"],
              "path": ["members"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.content && json.content.length > 0) {",
                  "    const member = json.content[0];",
                  "    pm.collectionVariables.set('member_id', member.id);",
                  "    console.log('member_id défini :', member.id, '—', member.firstName, member.lastName);",
                  "    pm.test('Membre récupéré', () => pm.expect(member.id).to.be.a('string'));",
                  "} else {",
                  "    console.warn('Aucun membre trouvé — créez un membre d abord');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 — Lister les espaces (prendre le 1er)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/reference/spaces",
              "host": ["{{base_url}}"],
              "path": ["reference", "spaces"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    const space = json.data[0];",
                  "    pm.collectionVariables.set('space_id', space.id);",
                  "    console.log('space_id défini :', space.id, '—', space.name);",
                  "    pm.test('Espace récupéré', () => pm.expect(space.id).to.be.a('string'));",
                  "} else {",
                  "    console.warn('Aucun espace trouvé — créez un espace d abord');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 — Lister les options disponibles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/reference/options",
              "host": ["{{base_url}}"],
              "path": ["reference", "options"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    const opt = json.data[0];",
                  "    pm.collectionVariables.set('option_id', opt.id);",
                  "    console.log('option_id défini :', opt.id, '—', opt.label);",
                  "} else {",
                  "    console.log('Pas d options disponibles (optionnel)');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Scénario NOMINAL — PENDING → APPROVED → CHECKED_IN",
      "description": "Flux complet d'une réservation réussie : création, approbation, check-in.",
      "item": [
        {
          "name": "1.1 — Créer une réservation (PENDING)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"{{member_id}}\",\n  \"spaceId\": \"{{space_id}}\",\n  \"startTime\": \"2026-03-15T09:00:00Z\",\n  \"endTime\": \"2026-03-15T11:00:00Z\",\n  \"guestCount\": 5,\n  \"notes\": \"Réunion équipe projet Alpha — test Postman\",\n  \"invitees\": [\n    {\n      \"name\": \"Aya Koné\",\n      \"email\": \"aya.kone@example.ci\",\n      \"phone\": \"+22507111001\"\n    },\n    {\n      \"name\": \"Ibrahima Diallo\",\n      \"email\": \"i.diallo@example.ci\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/reservations",
              "host": ["{{base_url}}"],
              "path": ["reservations"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('status = PENDING', () => pm.expect(json.data.status).to.eql('PENDING'));",
                  "pm.test('id présent (UUID)', () => pm.expect(json.data.id).to.match(/^[0-9a-f-]{36}$/i));",
                  "pm.test('memberId présent', () => pm.expect(json.data.memberId).to.be.a('string'));",
                  "pm.test('spaceId présent', () => pm.expect(json.data.spaceId).to.be.a('string'));",
                  "pm.test('invitees créés', () => pm.expect(json.data.invitees).to.have.lengthOf(2));",
                  "pm.collectionVariables.set('reservation_id', json.data.id);",
                  "pm.collectionVariables.set('reservation_pending_id', json.data.id);",
                  "console.log('Réservation créée :', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 — Récupérer la réservation créée",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["reservations", "{{reservation_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Réservation trouvée', () => pm.expect(json.success).to.be.true);",
                  "pm.test('id correspond', () => pm.expect(json.data.id).to.eql(pm.collectionVariables.get('reservation_id')));",
                  "pm.test('status = PENDING', () => pm.expect(json.data.status).to.eql('PENDING'));",
                  "console.log('Données réservation:', JSON.stringify(json.data, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 — Ajouter une option à la réservation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"{{option_id}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}/options",
              "host": ["{{base_url}}"],
              "path": ["reservations", "{{reservation_id}}", "options"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Skippé si pas d'option disponible",
                  "if (!pm.collectionVariables.get('option_id')) {",
                  "    console.log('Pas d option définie — étape ignorée');",
                  "    return;",
                  "}",
                  "const json = pm.response.json();",
                  "pm.test('Option ajoutée', () => pm.expect(json.success).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 — Approuver la réservation (PENDING → APPROVED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["reservations", "{{reservation_id}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Approbation réussie', () => pm.expect(json.success).to.be.true);",
                  "pm.test('status = APPROVED', () => pm.expect(json.data.status).to.eql('APPROVED'));",
                  "pm.collectionVariables.set('reservation_approved_id', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 — Check-in (APPROVED → CHECKED_IN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/reservations/{{reservation_id}}/check-in",
              "host": ["{{base_url}}"],
              "path": ["reservations", "{{reservation_id}}", "check-in"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Check-in réussi', () => pm.expect(json.success).to.be.true);",
                  "pm.test('status = CHECKED_IN', () => pm.expect(json.data.status).to.eql('CHECKED_IN'));"
                ]
              }
            }
          ]
        }
      ]
    },
