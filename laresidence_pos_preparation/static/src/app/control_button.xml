<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="laresidence_pos_preparation.ControlButtons"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Dans le panneau « Actions », et surtout pas dans la rangée
             principale. Place en rangee, ce bouton a fait deborder la
             largeur sur les tablettes du restaurant : le bouton « … » qui
             ouvre ce panneau sortait de l'ecran, et avec lui l'« Addition ».
             Constate en service le 19/10. La rangee principale est
             dimensionnee au pixel par Odoo, on n'y ajoute rien. -->
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="btn btn-light btn-lg app-border-color text-start laresidence-service-btn"
                    t-if="pos.config.module_pos_restaurant"
                    t-on-click="onClickLaresidenceService">
                <i class="fa fa-cutlery me-2" role="img" aria-hidden="true"/>
                <span>Plats servis</span>
            </button>
        </xpath>
    </t>

</templates>
