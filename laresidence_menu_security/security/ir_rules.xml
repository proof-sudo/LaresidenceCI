<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Tous les utilisateurs internes → lecture complète de tous les contacts -->
        <record id="rule_contacts_suppliers_only" model="ir.rule">
            <field name="name">Contacts : lecture complète (tous utilisateurs)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Anciennes règles division — désactivées (remplacées par group_contacts_full_details) -->
        <record id="rule_contacts_all_commercial" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="rule_contacts_all_direction" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
