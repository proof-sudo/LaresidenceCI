<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Tous les utilisateurs internes → lecture complète de tous les contacts -->
        <record id="rule_contacts_suppliers_only" model="ir.rule">
            <field name="name">Contacts : lecture complète (tous utilisateurs)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Règle GLOBALE (sans groupe = s'applique à tous, ET-ée avec les règles de groupe)
             → autorise la création uniquement pour group_contacts_full_details ou erp_manager
             → bloque pour tous les autres (dont CUISINE via purchase/mrp/stock_manager)
             Odoo 19 : groups_id retiré d'ir.ui.view, seule cette règle permet de restreindre create -->
        <record id="rule_partner_create_authorized_only" model="ir.rule">
            <field name="name">Contacts : création réservée aux utilisateurs autorisés</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1) if user.has_group('laresidence_menu_security.group_contacts_full_details') or user.has_group('base.group_erp_manager') else (0, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
