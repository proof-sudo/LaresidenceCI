<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ══════════════════════════════════════════════════════════════════
             Contacts : restriction fournisseurs uniquement pour users standard
             Exception : Division Commercial et Division Direction voient tout
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Tous les utilisateurs internes → fournisseurs + non-clients + utilisateurs Odoo (chatter) -->
        <record id="rule_contacts_suppliers_only" model="ir.rule">
            <field name="name">Contacts : fournisseurs uniquement (users standard)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', '|', ('supplier_rank', '&gt;', 0), ('customer_rank', '=', 0), ('user_ids', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Division Commercial → accès total contacts -->
        <record id="rule_contacts_all_commercial" model="ir.rule">
            <field name="name">Contacts : accès total Division Commercial</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('laresidence_menu_security.group_division_commercial'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Division Direction → accès total contacts -->
        <record id="rule_contacts_all_direction" model="ir.rule">
            <field name="name">Contacts : accès total Division Direction</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('laresidence_menu_security.group_division_direction'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>


    </data>
</odoo>
