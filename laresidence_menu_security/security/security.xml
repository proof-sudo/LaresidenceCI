<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Discuss : pas de groupe standard en Odoo 19 (conservé pour compatibilité) -->
        <record id="group_discuss_user" model="res.groups">
            <field name="name">Discuss / Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Approvals : pas de groupe standard en Odoo 19 -->
        <record id="group_approvals_user" model="res.groups">
            <field name="name">Approvals / Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Time Off : groupe custom pour users sans rôle RH officiel -->
        <record id="group_time_off_user" model="res.groups">
            <field name="name">Congés / Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Calendar : pas de groupe standard dédié en Odoo 19 -->
        <record id="group_calendar_user" model="res.groups">
            <field name="name">Calendrier / Utilisateur</field>
