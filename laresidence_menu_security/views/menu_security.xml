<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Menus avec base.group_user → groupe spécifique
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Discuss → visible par tous les utilisateurs internes -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Appointments → appointment.group_appointment_user -->
    <record id="appointment.main_menu_appointments" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('appointment.group_appointment_user')])]"/>
    </record>

    <!-- Calendar → groupe custom configurable -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_calendar_user')])]"/>
    </record>

    <!-- Contacts → base.group_partner_manager -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_partner_manager')])]"/>
    </record>

    <!-- Documents → documents.group_documents_user -->
    <record id="documents.menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('documents.group_documents_user')])]"/>
    </record>

    <!-- Planning → planning.group_planning_user -->
    <record id="planning.planning_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('planning.group_planning_user')])]"/>
    </record>

    <!-- Website → masqué via migration SQL (xmlid instable selon la version) -->

    <!-- Social Marketing → social.group_social_user -->
    <record id="social.menu_social_global" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('social.group_social_user')])]"/>
    </record>

    <!-- Employees → admin seulement -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

    <!-- Time Off → groupe custom configurable -->
    <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_time_off_user')])]"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Menus sans groupe (NO GROUP) → groupe ajouté
         ══════════════════════════════════════════════════════════════════ -->

    <!-- To-do → visible par tous (aucun groupe = accès libre) -->
    <record id="project_todo.menu_todo_todos" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- Knowledge → groupe custom configurable -->
    <record id="knowledge.knowledge_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_knowledge_user')])]"/>
    </record>

    <!-- Sales → complètement masqué (géré via theresidence_api) -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Location/Rental → groupe custom (accès explicite requis, personne par défaut) -->
    <record id="sale_renting.rental_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_rental_user')])]"/>
    </record>

    <!-- Dashboards → groupe custom configurable -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_dashboard_user')])]"/>
    </record>

    <!-- Approvals → groupe custom configurable -->
    <record id="approvals.approvals_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_approvals_user')])]"/>
    </record>

    <!-- WhatsApp → groupe custom configurable -->
    <record id="whatsapp.whatsapp_menu_main" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('laresidence_menu_security.group_whatsapp_user')])]"/>
    </record>

    <!-- Tests (menu debug) → admin seulement -->
    <record id="base.menu_tests" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Contacts : phone, mobile, email — visibles uniquement par Direction
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_partner_form_hide_phone_email" model="ir.ui.view">
        <field name="name">res.partner.form.hide.phone.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="phone" position="attributes">
                <attribute name="groups">laresidence_menu_security.group_division_direction</attribute>
            </field>
            <field name="email" position="attributes">
                <attribute name="groups">laresidence_menu_security.group_division_direction</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_tree_hide_phone_email" model="ir.ui.view">
        <field name="name">res.partner.tree.hide.phone.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="phone" position="attributes">
                <attribute name="groups">laresidence_menu_security.group_division_direction</attribute>
            </field>
            <field name="email" position="attributes">
                <attribute name="groups">laresidence_menu_security.group_division_direction</attribute>
            </field>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Frontdesk → les non-admin atterrissent directement sur Visiteurs
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Frontdesk / Stations → admin seulement (gestion des bornes) -->
    <record id="frontdesk.frontdesk_menu_stations" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

    <!-- Frontdesk / Rapports → admin seulement -->
    <record id="frontdesk.frontdesk_menu_report" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

</odoo>
