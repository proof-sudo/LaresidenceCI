<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_laresidence_pos_audit_sceller" model="ir.cron">
            <field name="name">Journal d'audit POS : scellement des lignes récentes</field>
            <field name="model_id" ref="model_laresidence_pos_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_sceller()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_laresidence_pos_audit_acces_permanents" model="ir.cron">
            <field name="name">Journal d'audit POS : relevé des clés d'accès permanentes</field>
            <field name="model_id" ref="model_laresidence_pos_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_detecter_acces_permanents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_laresidence_pos_audit_purge" model="ir.cron">
            <field name="name">Journal d'audit POS : purge de rétention</field>
            <field name="model_id" ref="model_laresidence_pos_audit"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
