<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laresidence_pos_audit_list" model="ir.ui.view">
        <field name="name">laresidence.pos.audit.list</field>
        <field name="model">laresidence.pos.audit</field>
        <field name="arch" type="xml">
            <list string="Journal d'audit du Point de Vente" create="false" edit="false" delete="false"
                  default_order="server_datetime desc">
                <field name="sequence_no" optional="show"
                       decoration-muted="not sequence_no"/>
                <field name="server_datetime"/>
                <field name="event_type"/>
                <field name="employee_id"/>
                <field name="device_identifier"/>
                <field name="browser_id" optional="hide"/>
                <field name="order_reference"/>
                <field name="tracking_number" optional="show"/>
                <field name="table_name" optional="show"/>
                <field name="product_name" optional="show"/>
                <field name="quantity" optional="hide" sum="Quantité"/>
                <field name="amount" optional="hide"/>
                <field name="old_value" optional="hide"/>
                <field name="new_value" optional="hide"/>
                <field name="clock_skew" optional="hide"
                       decoration-danger="clock_skew &gt; 120 or clock_skew &lt; -120"/>
                <field name="session_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="ip_address" optional="hide"/>
                <field name="payment_method" optional="hide"/>
                <field name="origin" optional="show"/>
                <field name="device_label" optional="hide"/>
                <field name="user_agent" optional="hide"/>
                <field name="origin_path" optional="hide"/>
                <field name="model_name" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="changes" optional="hide"/>
                <field name="device_id" optional="hide"/>
                <field name="session_fingerprint" optional="hide"/>
                <field name="ip_chain" optional="hide"/>
                <field name="device_local_ip" optional="hide"/>
                <field name="record_hash" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_laresidence_pos_audit_form" model="ir.ui.view">
        <field name="name">laresidence.pos.audit.form</field>
        <field name="model">laresidence.pos.audit</field>
        <field name="arch" type="xml">
            <form string="Événement d'audit" create="false" edit="false" delete="false">
                <sheet>
                    <h1><field name="display_label" readonly="1"/></h1>
                    <group>
                        <group string="Horodatage">
                            <field name="server_datetime"/>
                            <field name="client_datetime"/>
                            <field name="clock_skew"/>
                        </group>
                        <group string="Origine">
                            <field name="device_identifier"/>
                            <field name="browser_id"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                            <field name="origin"/>
                            <field name="origin_path"/>
                            <field name="user_agent"/>
                            <field name="device_label"/>
                            <field name="device_local_ip"/>
                            <field name="ip_chain"/>
                            <field name="device_id"/>
                            <field name="session_fingerprint"/>
                        </group>
                        <group string="Contexte">
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="order_reference"/>
                            <field name="order_uuid"/>
                            <field name="tracking_number"/>
                            <field name="table_name"/>
                        </group>
                        <group string="Valeurs">
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="quantity"/>
                            <field name="amount"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <group string="Écriture en base" invisible="not model_name">
                        <field name="model_name"/>
                        <field name="res_id"/>
                        <field name="changes" widget="text" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Chaîne d'intégrité">
                        <div class="alert alert-info" colspan="2" role="alert"
                             invisible="sequence_no">
                            Cette ligne n'est pas encore scellée. Le scellement a lieu
                            chaque minute, en dehors des transactions de caisse, pour ne
                            pas ralentir les encaissements.
                        </div>
                        <field name="sequence_no"/>
                        <field name="previous_hash"/>
                        <field name="record_hash"/>
                    </group>
                    <group string="Détail">
                        <field name="note" nolabel="1"/>
                    </group>
                    <group string="Relevé de l'appareil" invisible="not device_info">
                        <field name="device_info" widget="text" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_laresidence_pos_audit_search" model="ir.ui.view">
        <field name="name">laresidence.pos.audit.search</field>
        <field name="model">laresidence.pos.audit</field>
        <field name="arch" type="xml">
            <search string="Journal d'audit">
                <field name="order_reference"/>
                <field name="tracking_number"/>
                <field name="employee_id"/>
                <field name="device_identifier"/>
                <field name="browser_id"/>
                <field name="product_name"/>
                <field name="table_name"/>
                <field name="device_label"/>
                <field name="payment_method"/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('server_datetime','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter name="ouvertures" string="Ouvertures de commande" domain="[('event_type','=','order_open')]"/>
                <filter name="caissier" string="Changements de caissier"
                        domain="[('event_type','in',['cashier_change','cashier_restore'])]"/>
                <filter name="reconnexion_sans_code" string="Reconnexions sans code"
                        domain="[('event_type','=','cashier_restore')]"/>
                <filter name="impressions" string="Impressions"
                        domain="[('event_type','in',['print_bill','print_receipt'])]"/>
                <filter name="prix" string="Modifications de prix ou remise"
                        domain="[('event_type','in',['line_price','line_discount'])]"/>
                <filter name="suppressions" string="Retraits et suppressions"
                        domain="[('event_type','in',['line_remove','order_delete'])]"/>
                <separator/>
                <filter name="paiements" string="Paiements"
                        domain="[('event_type','in',['payment_add','payment_remove','payment_amount'])]"/>
                <filter name="authentification" string="Connexions et échecs"
                        domain="[('event_type','in',['auth_success','auth_failure'])]"/>
                <filter name="echecs_connexion" string="Échecs de connexion"
                        domain="[('event_type','=','auth_failure')]"/>
                <filter name="consultations" string="Consultations du journal"
                        domain="[('event_type','=','audit_read')]"/>
                <filter name="hors_caisse" string="Actions hors interface caisse"
                        domain="[('origin','!=','pos')]"/>
                <filter name="non_scellees" string="Pas encore scellées"
                        domain="[('sequence_no','=',False)]"/>
                <filter name="ecritures_base" string="Écritures en base"
                        domain="[('event_type','in',['db_create','db_write','db_unlink'])]"/>
                <separator/>
                <filter name="horloge" string="Horloge d'appareil décalée"
                        domain="['|',('clock_skew','&gt;',120),('clock_skew','&lt;',-120)]"/>
                <group>
                    <filter name="g_event" string="Événement" context="{'group_by':'event_type'}"/>
                    <filter name="g_emp" string="Caissier" context="{'group_by':'employee_id'}"/>
                    <filter name="g_device" string="Appareil" context="{'group_by':'device_identifier'}"/>
                    <filter name="g_order" string="Commande" context="{'group_by':'order_reference'}"/>
                    <filter name="g_session" string="Session" context="{'group_by':'session_id'}"/>
                    <filter name="g_date" string="Date" context="{'group_by':'server_datetime:day'}"/>
                    <filter name="g_origine" string="Origine" context="{'group_by':'origin'}"/>
                    <filter name="g_appareil" string="Appareil" context="{'group_by':'device_label'}"/>
                    <filter name="g_modele" string="Modèle concerné" context="{'group_by':'model_name'}"/>
                    <filter name="g_session" string="Session" context="{'group_by':'session_fingerprint'}"/>
                    <filter name="g_poste" string="Adresse locale" context="{'group_by':'device_local_ip'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_laresidence_pos_audit" model="ir.actions.act_window">
        <field name="name">Journal d'audit du Point de Vente</field>
        <field name="res_model">laresidence.pos.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_laresidence_pos_audit_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun événement enregistré pour l'instant.</p>
            <p>Le journal se remplit dès qu'une caisse est utilisée. Il est en lecture seule :
               ni vous ni l'administrateur ne pouvez en modifier le contenu.</p>
        </field>
    </record>

    <record id="action_verifier_integrite" model="ir.actions.server">
        <field name="name">Vérifier l'intégrité du journal</field>
        <field name="model_id" ref="model_laresidence_pos_audit"/>
        <field name="binding_model_id" ref="model_laresidence_pos_audit"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_verifier_integrite()</field>
    </record>

    <menuitem id="menu_laresidence_pos_audit"
              name="Journal d'audit"
              parent="point_of_sale.menu_point_rep"
              action="action_ouvrir_journal"
              groups="laresidence_pos_audit.group_pos_audit_viewer"
              sequence="90"/>

    <menuitem id="menu_laresidence_pos_audit_access"
              name="Accès au journal d'audit"
              parent="point_of_sale.menu_point_config_product"
              action="action_audit_access_config"
              groups="laresidence_pos_audit.group_pos_audit_officer"
              sequence="95"/>

</odoo>
