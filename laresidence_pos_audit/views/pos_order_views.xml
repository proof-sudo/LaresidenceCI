<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_audit" model="ir.ui.view">
        <field name="name">pos.order.form.audit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_audit" type="object"
                        string="Journal d'audit" icon="fa-history"
                        class="btn-secondary"
                        groups="point_of_sale.group_pos_manager"
                        invisible="audit_count == 0"/>
                <field name="audit_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
