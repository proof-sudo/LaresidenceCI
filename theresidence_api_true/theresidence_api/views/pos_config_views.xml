<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_config_form_inherit_close_sessions" model="ir.ui.view">
        <field name="name">pos.config.form.close.sessions</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_form"/>
        <field name="arch" type="xml">

            <!-- Bouton dans le header -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_close_all_pos_sessions"
                    type="object"
                    string="Fermer toutes les sessions POS"
                    class="btn-danger"
                    confirm="Cette action va fermer TOUTES les sessions POS ouvertes. Continuer ?"
                />
            </xpath>

        </field>
    </record>

</odoo>
