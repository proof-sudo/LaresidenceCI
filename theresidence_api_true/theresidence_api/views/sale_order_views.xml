<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- SALE.ORDER INHERIT    -->
    <!-- ===================== -->

    <!-- Inherit Form View -->
    <record id="view_sale_order_form_inherit_theresidence" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.theresidence</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Onglet Réservation -->
                <page string="Réservation TR" name="tr_reservation" invisible="not x_tr_is_reservation">
                    <group>
                        <group string="Informations réservation">
                            <field name="x_tr_is_reservation" invisible="1"/>
                            <field name="x_tr_uuid" readonly="1"/>
                            <field name="x_tr_qr_token" readonly="1"/>
                            <field name="x_tr_reservation_status"/>
                            <field name="x_tr_space_id"/>
                        </group>
                        <group string="Horaires">
                            <field name="x_tr_start_time"/>
                            <field name="x_tr_end_time"/>
                            <field name="x_tr_guest_count"/>
                        </group>
                    </group>
                    <group invisible="not x_tr_rejection_reason">
                        <field name="x_tr_rejection_reason"/>
                    </group>
                    <group>
                        <field name="x_tr_notes" placeholder="Notes sur la réservation..."/>
                    </group>
                    <notebook>
                        <page string="Options" name="options">
                            <field name="x_tr_option_ids">
                                <list string="Options" editable="bottom">
                                    <field name="option_def_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invités" name="invitees">
                            <field name="x_tr_invitee_ids">
                                <list string="Invités" editable="bottom">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
                <!-- Onglet Abonnement -->
                <page string="Abonnement TR" name="tr_subscription" invisible="not x_tr_is_subscription">
                    <group>
                        <group string="Informations abonnement">
                            <field name="x_tr_is_subscription" invisible="1"/>
                            <field name="x_tr_uuid" readonly="1"/>
                            <field name="x_tr_subscription_status"/>
                            <field name="x_tr_plan_id"/>
                        </group>
                        <group string="Facturation">
                            <field name="x_tr_billing_period"/>
                            <field name="x_tr_auto_renew"/>
                            <field name="x_tr_sub_start_date"/>
                            <field name="x_tr_sub_end_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- Ajouter les boutons d'action pour les réservations -->
            <xpath expr="//header" position="inside">
                <button name="action_reserve_reservation" type="object" string="Réserver"
                    class="btn-primary" invisible="not x_tr_is_reservation or x_tr_reservation_status != 'PENDING'"/>
                <button name="action_arrive_reservation" type="object" string="Marquer arrivée"
                    class="btn-primary" invisible="not x_tr_is_reservation or x_tr_reservation_status != 'RESERVED'"/>
                <button name="action_release_reservation" type="object" string="Libérer l'espace"
                    class="btn-primary" invisible="not x_tr_is_reservation or x_tr_reservation_status != 'ARRIVED'"/>
                <button name="action_cancel_reservation" type="object" string="Annuler réservation"
                    class="btn-secondary" invisible="not x_tr_is_reservation or x_tr_reservation_status in ('CANCELLED', 'COMPLETED')"/>
            </xpath>
            <!-- Ajouter les boutons d'action pour les abonnements -->
            <xpath expr="//header" position="inside">
                <button name="action_pause_subscription" type="object" string="Mettre en pause" 
                    class="btn-secondary" invisible="not x_tr_is_subscription or x_tr_subscription_status != 'ACTIVE'"/>
                <button name="action_resume_subscription" type="object" string="Reprendre" 
                    class="btn-primary" invisible="not x_tr_is_subscription or x_tr_subscription_status != 'PAUSED'"/>
                <button name="action_cancel_subscription" type="object" string="Annuler abonnement" 
                    class="btn-secondary" invisible="not x_tr_is_subscription or x_tr_subscription_status in ('CANCELLED', 'EXPIRED')"/>
            </xpath>
        </field>
    </record>

    <!-- Vue liste dédiée aux réservations (primaire, utilisée par action_theresidence_reservations) -->
    <record id="view_theresidence_reservations_list" model="ir.ui.view">
        <field name="name">theresidence.reservations.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Réservations" default_order="x_tr_start_time desc">
                <field name="name" string="N° Réservation"/>
                <field name="partner_id" string="Client"/>
                <field name="x_tr_space_id" string="Espace"/>
                <field name="x_tr_start_time" string="Début"/>
                <field name="x_tr_end_time" string="Fin"/>
                <field name="x_tr_guest_count" string="Invités"/>
                <field name="x_tr_reservation_status" string="Statut" widget="badge"
                       decoration-primary="x_tr_reservation_status == 'PENDING'"
                       decoration-success="x_tr_reservation_status == 'RESERVED'"
                       decoration-warning="x_tr_reservation_status == 'ARRIVED'"
                       decoration-info="x_tr_reservation_status == 'COMPLETED'"
                       decoration-danger="x_tr_reservation_status == 'CANCELLED'"/>
                <field name="amount_total" string="Montant"/>
            </list>
        </field>
    </record>

    <!-- Inherit list View (liste globale ventes — champs TR en option masquée) -->
    <record id="view_sale_order_list_inherit_theresidence" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.theresidence</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="x_tr_is_reservation" column_invisible="1"/>
                <field name="x_tr_is_subscription" column_invisible="1"/>
                <field name="x_tr_reservation_status" optional="hide"/>
                <field name="x_tr_subscription_status" optional="hide"/>
                <field name="x_tr_space_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sale_order_search_inherit_theresidence" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.theresidence</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_quotation']" position="after">
                <separator/>
                <filter string="Réservations TR" name="tr_reservations" domain="[('x_tr_is_reservation', '=', True)]"/>
                <filter string="Abonnements TR" name="tr_subscriptions" domain="[('x_tr_is_subscription', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Statut réservation" name="group_reservation_status" context="{'group_by': 'x_tr_reservation_status'}"/>
                <filter string="Espace" name="group_space" context="{'group_by': 'x_tr_space_id'}"/>
                <filter string="Statut abonnement" name="group_subscription_status" context="{'group_by': 'x_tr_subscription_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- Action pour les réservations -->
    <record id="action_theresidence_reservations" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('x_tr_is_reservation', '=', True)]</field>
        <field name="context">{'default_x_tr_is_reservation': True}</field>
        <field name="view_ids" eval="[
            (5,),
            (0, 0, {'view_mode': 'list', 'view_id': ref('theresidence_api.view_theresidence_reservations_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle réservation
            </p>
        </field>
    </record>

    <!-- Vue calendrier pour les réservations -->
    <record id="view_sale_order_calendar_theresidence" model="ir.ui.view">
        <field name="name">sale.order.calendar.theresidence</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <calendar string="Réservations" date_start="x_tr_start_time" date_stop="x_tr_end_time" color="x_tr_space_id" mode="week">
                <field name="partner_id"/>
                <field name="x_tr_space_id"/>
                <field name="x_tr_reservation_status"/>
            </calendar>
        </field>
    </record>

    <!-- Action pour les abonnements -->
    <record id="action_theresidence_subscriptions" model="ir.actions.act_window">
        <field name="name">Abonnements</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_tr_is_subscription', '=', True)]</field>
        <field name="context">{'default_x_tr_is_subscription': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouvel abonnement
            </p>
        </field>
    </record>

    <menuitem id="menu_theresidence_reservations"
        name="Réservations"
        parent="menu_theresidence_root"
        action="action_theresidence_reservations"
        groups="theresidence_api.group_tr_reservations,theresidence_api.group_tr_admin"
        sequence="1"/>

    <menuitem id="menu_theresidence_subscriptions"
        name="Abonnements"
        parent="menu_theresidence_root"
        action="action_theresidence_subscriptions"
        groups="theresidence_api.group_tr_subscriptions,theresidence_api.group_tr_admin"
        sequence="2"/>

</odoo>
