            </form>
        </field>
    </record>

    <record id="action_theresidence_menu_kind" model="ir.actions.act_window">
        <field name="name">Types de menu</field>
        <field name="res_model">theresidence.menu.kind</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MENUS                 -->
    <!-- ===================== -->

    <menuitem id="menu_theresidence_root"
        name="The Residence API"
        web_icon="theresidence_api,static/description/icon.svg"
        groups="theresidence_api.group_tr_admin,theresidence_api.group_tr_members,theresidence_api.group_tr_reservations,theresidence_api.group_tr_subscriptions,theresidence_api.group_tr_orders,theresidence_api.group_tr_config"
        sequence="100"/>

    <menuitem id="menu_theresidence_config"
        name="Configuration"
        parent="menu_theresidence_root"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="10"/>

    <menuitem id="menu_theresidence_api_key"
        name="Clés API"
        parent="menu_theresidence_config"
        action="action_theresidence_api_key"
        groups="theresidence_api.group_tr_admin"
        sequence="1"/>

    <menuitem id="menu_theresidence_webhook"
        name="Webhooks"
        parent="menu_theresidence_config"
        action="action_theresidence_webhook"
        groups="theresidence_api.group_tr_admin"
        sequence="2"/>

    <menuitem id="menu_theresidence_webhook_event_type"
        name="Types d'événements"
        parent="menu_theresidence_config"
        action="action_theresidence_webhook_event_type"
        groups="theresidence_api.group_tr_admin"
        sequence="3"/>

    <menuitem id="menu_theresidence_reference"
        name="Données de référence"
        parent="menu_theresidence_root"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="20"/>

    <menuitem id="menu_theresidence_membership_type"
        name="Types d'adhésion"
        parent="menu_theresidence_reference"
        action="action_theresidence_membership_type"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="1"/>

    <menuitem id="menu_theresidence_space_type"
        name="Types d'espace"
        parent="menu_theresidence_reference"
        action="action_theresidence_space_type"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="2"/>

    <menuitem id="menu_theresidence_reservation_option"
        name="Options de réservation"
        parent="menu_theresidence_reference"
        action="action_theresidence_reservation_option_def"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="3"/>

    <menuitem id="menu_theresidence_menu_kind"
        name="Types de menu"
        parent="menu_theresidence_reference"
        action="action_theresidence_menu_kind"
        groups="theresidence_api.group_tr_config,theresidence_api.group_tr_admin"
        sequence="4"/>

</odoo>
