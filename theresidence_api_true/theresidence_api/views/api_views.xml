        <field name="model">theresidence.menu.kind</field>
        <field name="arch" type="xml">
            <form string="Type de menu">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="x_uuid" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
