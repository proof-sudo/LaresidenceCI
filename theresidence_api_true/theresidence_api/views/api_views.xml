<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- API KEY VIEWS         -->
    <!-- ===================== -->
    
    <record id="view_theresidence_api_key_list" model="ir.ui.view">
        <field name="name">theresidence.api.key.list</field>
        <field name="model">theresidence.api.key</field>
        <field name="arch" type="xml">
            <list string="Clés API">
                <field name="name"/>
                <field name="key"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="can_read_members"/>
                <field name="can_write_members"/>
                <field name="can_read_reservations"/>
                <field name="can_write_reservations"/>
                <field name="can_read_orders"/>
                <field name="can_write_orders"/>
            </list>
        </field>
    </record>

    <record id="view_theresidence_api_key_form" model="ir.ui.view">
        <field name="name">theresidence.api.key.form</field>
        <field name="model">theresidence.api.key</field>
        <field name="arch" type="xml">
            <form string="Clé API">
                <header>
                    <button name="regenerate_key" type="object" string="Regénérer la clé" class="btn-secondary" confirm="Êtes-vous sûr de vouloir regénérer cette clé API ? L'ancienne clé ne fonctionnera plus."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive" invisible="1">
                            <field name="is_active" widget="boolean_button"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="is_active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key" readonly="1"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <group>
                                <group string="Membres">
                                    <field name="can_read_members"/>
                                    <field name="can_write_members"/>
                                </group>
                                <group string="Espaces">
                                    <field name="can_read_spaces"/>
                                    <field name="can_read_menu"/>
                                </group>
                                <group string="Réservations">
                                    <field name="can_read_reservations"/>
                                    <field name="can_write_reservations"/>
                                </group>
                                <group string="Commandes">
                                    <field name="can_read_orders"/>
                                    <field name="can_write_orders"/>
                                </group>
                                <group string="Abonnements">
                                    <field name="can_read_subscriptions"/>
                                    <field name="can_write_subscriptions"/>
                                </group>
                                <group string="Webhooks">
                                    <field name="can_manage_webhooks"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_theresidence_api_key" model="ir.actions.act_window">
        <field name="name">Clés API</field>
        <field name="res_model">theresidence.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle clé API
            </p>
            <p>
                Les clés API permettent à l'application mobile de communiquer avec Odoo.
            </p>
        </field>
    </record>

    <!-- ===================== -->
    <!-- WEBHOOK VIEWS         -->
    <!-- ===================== -->

    <record id="view_theresidence_webhook_list" model="ir.ui.view">
        <field name="name">theresidence.webhook.list</field>
        <field name="model">theresidence.webhook</field>
        <field name="arch" type="xml">
            <list string="Webhooks">
                <field name="name"/>
                <field name="url"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="event_type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_theresidence_webhook_form" model="ir.ui.view">
        <field name="name">theresidence.webhook.form</field>
        <field name="model">theresidence.webhook</field>
        <field name="arch" type="xml">
            <form string="Webhook">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="secret" password="True"/>
                            <field name="event_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique des événements" name="events">
                            <field name="event_ids" readonly="1">
                                <list string="Événements" default_order="create_date desc">
                                    <field name="create_date"/>
                                    <field name="event_type"/>
                                    <field name="status" decoration-success="status == 'SUCCESS'" decoration-danger="status == 'FAILED'" decoration-warning="status == 'PENDING'"/>
                                    <field name="response_code"/>
                                    <field name="sent_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_theresidence_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">theresidence.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurer un nouveau webhook
            </p>
            <p>
                Les webhooks permettent de notifier des systèmes externes lors d'événements.
            </p>
        </field>
    </record>

    <!-- Webhook Event Types -->
    <record id="view_theresidence_webhook_event_type_list" model="ir.ui.view">
        <field name="name">theresidence.webhook.event.type.list</field>
        <field name="model">theresidence.webhook.event.type</field>
        <field name="arch" type="xml">
            <list string="Types d'événements">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_theresidence_webhook_event_type" model="ir.actions.act_window">
        <field name="name">Types d'événements</field>
        <field name="res_model">theresidence.webhook.event.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MEMBERSHIP TYPE VIEWS -->
    <!-- ===================== -->

    <record id="view_theresidence_membership_type_list" model="ir.ui.view">
        <field name="name">theresidence.membership.type.list</field>
        <field name="model">theresidence.membership.type</field>
        <field name="arch" type="xml">
            <list string="Types d'adhésion">
                <field name="sort_order" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="x_uuid"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_theresidence_membership_type_form" model="ir.ui.view">
        <field name="name">theresidence.membership.type.form</field>
        <field name="model">theresidence.membership.type</field>
        <field name="arch" type="xml">
            <form string="Type d'adhésion">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sort_order"/>
                        </group>
                        <group>
                            <field name="x_uuid" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_theresidence_membership_type" model="ir.actions.act_window">
        <field name="name">Types d'adhésion</field>
        <field name="res_model">theresidence.membership.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- SPACE TYPE VIEWS      -->
    <!-- ===================== -->

    <record id="view_theresidence_space_type_list" model="ir.ui.view">
        <field name="name">theresidence.space.type.list</field>
        <field name="model">theresidence.space.type</field>
        <field name="arch" type="xml">
            <list string="Types d'espace">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_theresidence_space_type_form" model="ir.ui.view">
        <field name="name">theresidence.space.type.form</field>
        <field name="model">theresidence.space.type</field>
        <field name="arch" type="xml">
            <form string="Type d'espace">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_theresidence_space_type" model="ir.actions.act_window">
        <field name="name">Types d'espace</field>
        <field name="res_model">theresidence.space.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- RESERVATION OPTIONS   -->
    <!-- ===================== -->

    <record id="view_theresidence_reservation_option_def_list" model="ir.ui.view">
        <field name="name">theresidence.reservation.option.def.list</field>
        <field name="model">theresidence.reservation.option.def</field>
        <field name="arch" type="xml">
            <list string="Options de réservation">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="scope"/>
                <field name="price"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
            </list>
        </field>
    </record>

    <record id="view_theresidence_reservation_option_def_form" model="ir.ui.view">
        <field name="name">theresidence.reservation.option.def.form</field>
        <field name="model">theresidence.reservation.option.def</field>
        <field name="arch" type="xml">
            <form string="Option de réservation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="x_uuid" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_theresidence_reservation_option_def" model="ir.actions.act_window">
        <field name="name">Options de réservation</field>
        <field name="res_model">theresidence.reservation.option.def</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MENU KIND VIEWS       -->
    <!-- ===================== -->

    <record id="view_theresidence_menu_kind_list" model="ir.ui.view">
        <field name="name">theresidence.menu.kind.list</field>
        <field name="model">theresidence.menu.kind</field>
        <field name="arch" type="xml">
            <list string="Types de menu">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
