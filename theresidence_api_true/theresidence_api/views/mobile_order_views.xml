<odoo>
    <!-- Form view -->
    <record id="view_mobile_order_form" model="ir.ui.view">
        <field name="name">mobile.order.form</field>
        <field name="model">mobile.order</field>
        <field name="arch" type="xml">
            <form string="Commande Mobile">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="date_order"/>
                        <field name="x_tr_order_status"/>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="lines">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_validate" type="object" string="Valider" class="btn-primary"/>
                        <button name="action_send_to_pos" type="object" string="Envoyer au POS" class="btn-success"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list view -->
    <record id="view_mobile_order_list" model="ir.ui.view">
        <field name="name">mobile.order.list</field>
        <field name="model">mobile.order</field>
        <field name="arch" type="xml">
            <list string="Commandes Mobiles">
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="x_tr_order_status"/>
            </list>
        </field>
    </record>

    <!-- Menus et sous-menus -->
    <menuitem id="menu_mobile_orders_root" name="Commandes Mobile" parent="point_of_sale.menu_point_root"/>

    <menuitem id="menu_mobile_orders_pending" name="En attente" parent="menu_mobile_orders_root"
              action="action_mobile_order_pending"/>
    <menuitem id="menu_mobile_orders_validated" name="Confirmée" parent="menu_mobile_orders_root"
              action="action_mobile_order_validated"/>
    <menuitem id="menu_mobile_orders_sent" name="Envoyées au POS" parent="menu_mobile_orders_root"
              action="action_mobile_order_sent"/>

    <!-- Actions pour les sous-menus -->
    <record id="action_mobile_order_pending" model="ir.actions.act_window">
        <field name="name">Commandes Mobile En attente</field>
        <field name="res_model">mobile.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_tr_order_status', '=', 'PENDING')]</field>
    </record>

    <record id="action_mobile_order_validated" model="ir.actions.act_window">
        <field name="name">Commandes Mobile Validées</field>
        <field name="res_model">mobile.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_tr_order_status', '=', 'CONFIRMED')]</field>
    </record>

    <record id="action_mobile_order_sent" model="ir.actions.act_window">
        <field name="name">Commandes Mobile Envoyées au POS</field>
        <field name="res_model">mobile.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_tr_order_status', '=', 'SENT_TO_POS')]</field>
    </record>
</odoo>