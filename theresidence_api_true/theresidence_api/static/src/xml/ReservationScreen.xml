<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================== -->
    <!-- Bouton Navbar                  -->
    <!-- ============================== -->
    <t t-name="theresidence_api.ReservationButton">
        <button class="tr-reservation-btn" t-on-click="onClick">
            <i class="fa fa-calendar" />
            <span>Réservations</span>
            <t t-if="pendingCount > 0">
                <span class="tr-badge" t-esc="pendingCount"/>
            </t>
        </button>
    </t>

    <!-- ============================== -->
    <!-- Écran principal                -->
    <!-- ============================== -->
    <t t-name="theresidence_api.ReservationScreen">
        <div class="tr-reservation-screen">

            <!-- Header -->
            <div class="tr-header">
                <button class="tr-back-btn" t-on-click="back">
                    <i class="fa fa-arrow-left" /> Retour
                </button>
                <h2>Réservations du jour</h2>
                <button class="tr-refresh-btn" t-on-click="loadReservations">
                    <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''" />
                </button>
            </div>

            <!-- Filtres -->
            <div class="tr-filters">
                <button t-att-class="'tr-filter-btn ' + (state.filter === 'ALL' ? 'active' : '')"
                        t-on-click="() => this.setFilter('ALL')">Tous</button>
                <button t-att-class="'tr-filter-btn pending ' + (state.filter === 'PENDING' ? 'active' : '')"
                        t-on-click="() => this.setFilter('PENDING')">En attente</button>
                <button t-att-class="'tr-filter-btn approved ' + (state.filter === 'APPROVED' ? 'active' : '')"
                        t-on-click="() => this.setFilter('APPROVED')">Approuvées</button>
                <button t-att-class="'tr-filter-btn checkin ' + (state.filter === 'CHECKED_IN' ? 'active' : '')"
                        t-on-click="() => this.setFilter('CHECKED_IN')">Check-in</button>
            </div>

            <!-- Contenu -->
            <div class="tr-content">

                <!-- Loading -->
                <div t-if="state.loading" class="tr-loading">
                    <i class="fa fa-spinner fa-spin fa-2x" />
                    <p>Chargement des réservations...</p>
                </div>

                <!-- Vide -->
                <div t-elif="filteredReservations.length === 0" class="tr-empty">
                    <i class="fa fa-calendar-o fa-3x" />
                    <p>Aucune réservation pour aujourd'hui</p>
                </div>

                <!-- Liste des réservations -->
                <div t-else="" class="tr-list">
                    <t t-foreach="filteredReservations" t-as="res" t-key="res.id">
                        <div t-att-class="'tr-card status-' + res.status.toLowerCase()">

                            <!-- Statut badge -->
                            <div class="tr-card-header">
                                <span t-att-class="'tr-status-badge ' + res.status.toLowerCase()"
                                      t-esc="statusLabel(res.status)"/>
                                <span class="tr-time">
                                    <i class="fa fa-clock-o" />
                                    <t t-esc="formatTime(res.startTime)" /> - <t t-esc="formatTime(res.endTime)" />
                                </span>
                            </div>

                            <!-- Infos principales -->
                            <div class="tr-card-body">
                                <div class="tr-member">
                                    <i class="fa fa-user" />
                                    <strong t-esc="res.memberFirstName + ' ' + res.memberLastName" />
                                </div>
                                <div class="tr-space">
                                    <i class="fa fa-map-marker" />
                                    <span t-esc="res.spaceName" />
                                </div>
                                <div class="tr-guests" t-if="res.guestCount > 0">
                                    <i class="fa fa-users" />
                                    <span><t t-esc="res.guestCount" /> invité(s)</span>
                                </div>
                                <div class="tr-notes" t-if="res.notes">
                                    <i class="fa fa-sticky-note-o" />
                                    <span t-esc="res.notes" />
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="tr-card-actions">
                                <button t-if="res.status === 'PENDING'"
                                        class="tr-action-btn approve"
                                        t-on-click="() => this.approveReservation(res.id)"
                                        t-att-disabled="state.actionLoading === res.id">
                                    <i class="fa fa-check" /> Approuver
                                </button>
                                <button t-if="res.status === 'APPROVED'"
                                        class="tr-action-btn checkin"
                                        t-on-click="() => this.checkinReservation(res.id)"
                                        t-att-disabled="state.actionLoading === res.id">
                                    <i class="fa fa-sign-in" /> Check-in
                                </button>
                                <button t-if="res.status !== 'CHECKED_IN'"
                                        class="tr-action-btn cancel"
                                        t-on-click="() => this.cancelReservation(res.id)"
                                        t-att-disabled="state.actionLoading === res.id">
                                    <i class="fa fa-times" /> Annuler
                                </button>
                            </div>

                        </div>
                    </t>
                </div>

            </div>
        </div>
    </t>

</templates>
