<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_ouverture_wizard_form" model="ir.ui.view">
        <field name="name">laresidence.mail.ouverture.wizard.form</field>
        <field name="model">laresidence.mail.ouverture.wizard</field>
        <field name="arch" type="xml">
            <form string="Ouvrir temporairement les envois">
                <field name="envois_ouverts" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="envois_ouverts">
                    Aucun e-mail ne sort de cette base. Ouvrir une fenêtre autorise
                    les envois pour la durée choisie, puis le blocage se rétablit
                    tout seul.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not envois_ouverts">
                    Les envois sont actuellement <b>ouverts</b>, jusqu'à
                    <field name="ouvert_jusqua" readonly="1" nolabel="1" class="oe_inline"/>.
                </div>
                <group>
                    <field name="duree"/>
                    <field name="motif" placeholder="Ex. : renvoyer la facture du client X"/>
                </group>
                <footer>
                    <button name="action_ouvrir" type="object" string="Ouvrir les envois"
                            class="btn-primary"/>
                    <button name="action_refermer" type="object" string="Refermer maintenant"
                            class="btn-danger" invisible="not envois_ouverts"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_ouverture_wizard" model="ir.actions.act_window">
        <field name="name">Ouvrir temporairement les envois</field>
        <field name="res_model">laresidence.mail.ouverture.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
