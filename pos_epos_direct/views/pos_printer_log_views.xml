<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des logs -->
    <record id="view_pos_printer_log_list" model="ir.ui.view">
        <field name="name">pos.printer.log.list</field>
        <field name="model">pos.printer.log</field>
        <field name="arch" type="xml">
            <list string="Logs d'impression" decoration-danger="status == 'error'" default_order="create_date desc">
                <field name="create_date" string="Date"/>
                <field name="printer_name" string="Imprimante"/>
                <field name="order_name" string="Commande"/>
                <field name="job_type" string="Type"/>
                <field name="status" string="Statut" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
                <field name="duration_ms" string="Durée (ms)"/>
                <field name="ip" string="IP"/>
                <field name="message" string="Détails" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Formulaire log (lecture seule) -->
    <record id="view_pos_printer_log_form" model="ir.ui.view">
        <field name="name">pos.printer.log.form</field>
        <field name="model">pos.printer.log</field>
        <field name="arch" type="xml">
            <form string="Log d'impression" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="printer_id" string="Imprimante"/>
                            <field name="printer_name" string="Nom imprimante"/>
                            <field name="order_name" string="Commande"/>
                        </group>
                        <group>
                            <field name="job_type" string="Type"/>
                            <field name="status" string="Statut" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'error'"/>
                            <field name="duration_ms" string="Durée (ms)"/>
                            <field name="ip" string="IP imprimante"/>
                        </group>
                    </group>
                    <group string="Détails" invisible="not message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action fenêtre globale -->
    <record id="action_pos_printer_log" model="ir.actions.act_window">
        <field name="name">Logs d'impression ePOS</field>
        <field name="res_model">pos.printer.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

