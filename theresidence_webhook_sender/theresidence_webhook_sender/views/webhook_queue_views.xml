<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue formulaire pour la queue -->
    <record id="view_webhook_queue_form" model="ir.ui.view">
        <field name="name">theresidence.webhook.queue.form</field>
        <field name="model">theresidence.webhook.queue</field>
        <field name="arch" type="xml">
            <form string="Webhook" create="false">
                <header>
                    <button name="action_retry_now" type="object" string="Réessayer maintenant" 
                            class="oe_highlight" invisible="state == 'sent'"/>
                    <button name="action_mark_as_failed" type="object" string="Marquer comme échoué" 
                            class="btn-secondary" invisible="state == 'sent'"/>
                    <button name="action_view_logs" type="object" string="Voir les logs" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sending,sent"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_copy_payload" type="object" class="oe_stat_button" icon="fa-clipboard">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Copier payload</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="event_id" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="event_type" readonly="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Entité">
                            <field name="entity_type" readonly="1"/>
                            <field name="entity_id" readonly="1"/>
                            <field name="timestamp" readonly="1"/>
                        </group>
                        
                        <group string="État">
                            <field name="priority"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="next_retry" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Résultat" invisible="state == 'pending'">
                        <field name="response_code" readonly="1"/>
                        <field name="sent_at" readonly="1"/>
                    </group>
                    
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="full_payload" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        
                        <page string="Données brutes" name="data">
                            <field name="payload_data" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        
                        <page string="Réponse API" name="response" invisible="not response_body">
                            <field name="response_body" readonly="1"/>
                        </page>
                        
                        <page string="Erreur" name="error" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                        
                        <page string="Informations internes" name="internal">
                            <group>
                                <field name="internal_event_type" readonly="1"/>
                                <field name="old_status" readonly="1"/>
                                <field name="new_status" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vue liste pour la queue -->
    <record id="view_webhook_queue_list" model="ir.ui.view">
        <field name="name">theresidence.webhook.queue.list</field>
        <field name="model">theresidence.webhook.queue</field>
        <field name="arch" type="xml">
            <list string="Queue Webhooks" decoration-success="state == 'sent'" 
                  decoration-danger="state == 'failed'" decoration-muted="state == 'pending'">
                <field name="priority" widget="priority"/>
                <field name="create_date" string="Créé le"/>
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'" 
                       decoration-danger="state == 'failed'"/>
                <field name="retry_count"/>
                <field name="next_retry"/>
                <field name="sent_at"/>
                <button name="action_retry_now" type="object" string="Réessayer" 
                        icon="fa-refresh" invisible="state == 'sent'"/>
            </list>
        </field>
    </record>
    
    <!-- Vue Kanban pour la queue -->
    <record id="view_webhook_queue_kanban" model="ir.ui.view">
        <field name="name">theresidence.webhook.queue.kanban</field>
        <field name="model">theresidence.webhook.queue</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <field name="state"/>
                <field name="retry_count"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="event_type"/>
                                    </strong>
                                </div>
                                <span class="badge" t-att-class="record.state.raw_value === 'sent' ? 'badge-success' : record.state.raw_value === 'failed' ? 'badge-danger' : 'badge-warning'">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="entity_type"/> - <field name="entity_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>Tentatives: <field name="retry_count"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="create_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Recherche pour la queue -->
    <record id="view_webhook_queue_search" model="ir.ui.view">
        <field name="name">theresidence.webhook.queue.search</field>
        <field name="model">theresidence.webhook.queue</field>
        <field name="arch" type="xml">
            <search string="Rechercher webhooks">
                <field name="event_id"/>
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <separator/>
                <filter string="En attente" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Envoyés" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Échoués" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="À réessayer" name="to_retry" domain="[('state', '=', 'failed'), ('next_retry', '!=', False)]"/>
                <separator/>
                <filter string="Commandes" name="orders" domain="[('entity_type', '=', 'order')]"/>
                <filter string="Réservations" name="reservations" domain="[('entity_type', '=', 'reservation')]"/>
                <filter string="Abonnements" name="subscriptions" domain="[('entity_type', '=', 'subscription')]"/>
                <filter string="Membres" name="members" domain="[('entity_type', '=', 'member')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type événement" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Type entité" name="group_entity_type" context="{'group_by': 'entity_type'}"/>
                    <filter string="Date création" name="group_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action pour ouvrir la queue -->
    <record id="action_webhook_queue" model="ir.actions.act_window">
        <field name="name">Queue Webhooks</field>
        <field name="res_model">theresidence.webhook.queue</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Aucun webhook dans la queue
            </p>
            <p>
                Les webhooks apparaîtront ici lorsqu'ils seront déclenchés par les événements
                dans Odoo (commandes, réservations, abonnements).
            </p>
        </field>
    </record>
    
</odoo>
