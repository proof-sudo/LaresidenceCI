<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue formulaire pour la configuration -->
    <record id="view_webhook_config_form" model="ir.ui.view">
        <field name="name">theresidence.webhook.config.form</field>
        <field name="model">theresidence.webhook.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Webhook">
                <header>
                    <button name="action_test_connection" type="object" string="Tester la connexion" class="oe_highlight"/>
                    <button name="action_process_queue_now" type="object" string="Traiter la queue maintenant" class="btn-secondary"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ex: The Residence API"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Configuration API">
                            <field name="base_url" placeholder="https://api.laresidence-abidjan.com"/>
                            <field name="api_key" password="True"/>
                            <field name="timeout"/>
                        </group>
                        
                        <group string="Gestion des erreurs">
                            <field name="max_retries"/>
                            <field name="retry_delays"/>
                        </group>
                    </group>
                    
                    <group string="Options">
                        <field name="send_created_events"/>
                        <field name="enable_debug_logs"/>
                    </group>
                    
                    <group string="Statistiques" col="4">
                        <field name="total_sent" readonly="1"/>
                        <field name="total_pending" readonly="1"/>
                        <field name="total_failed" readonly="1"/>
                    </group>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_queue" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="total_pending" widget="statinfo" string="En attente"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Logs</span>
                            </div>
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vue liste pour la configuration -->
    <record id="view_webhook_config_tree" model="ir.ui.view">
        <field name="name">theresidence.webhook.config.tree</field>
        <field name="model">theresidence.webhook.config</field>
        <field name="arch" type="xml">
            <tree string="Configurations Webhook">
                <field name="name"/>
                <field name="base_url"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="total_sent"/>
                <field name="total_pending"/>
                <field name="total_failed"/>
            </tree>
        </field>
    </record>
    
    <!-- Action pour ouvrir la configuration -->
    <record id="action_webhook_config" model="ir.actions.act_window">
        <field name="name">Configuration Webhook</field>
        <field name="res_model">theresidence.webhook.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez la connexion vers l'API externe de The Residence
            </p>
            <p>
                Cette configuration permet d'envoyer automatiquement des webhooks
                vers l'API externe lorsque des événements se produisent dans Odoo.
            </p>
        </field>
    </record>
    
</odoo>
