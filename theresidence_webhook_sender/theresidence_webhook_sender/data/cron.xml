<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron job pour traiter la queue des webhooks -->
        <record id="ir_cron_process_webhook_queue" model="ir.cron">
            <field name="name">Traiter la queue des webhooks sortants</field>
            <field name="model_id" ref="model_theresidence_webhook_service"/>
            <field name="state">code</field>
            <field name="code">model._process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>
        
        <!-- Cron job pour nettoyer les anciens webhooks (optionnel) -->
        <record id="ir_cron_cleanup_old_webhooks" model="ir.cron">
            <field name="name">Nettoyer les anciens webhooks envoyés</field>
            <field name="model_id" ref="model_theresidence_webhook_queue"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_records(days=30)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>
        
        <!-- Cron job pour nettoyer les anciens logs (optionnel) -->
        <record id="ir_cron_cleanup_old_logs" model="ir.cron">
            <field name="name">Nettoyer les anciens logs de webhooks</field>
            <field name="model_id" ref="model_theresidence_webhook_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs(days=90)</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>
        
    </data>
</odoo>
