    <record id="action_residence_subscriptions" model="ir.actions.act_window">
        <field name="name">Abonnements</field>
        <field name="res_model">residence.member.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_residence_subscription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun abonnement
            </p>
        </field>
