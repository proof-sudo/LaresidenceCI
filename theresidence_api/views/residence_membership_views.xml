<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         TYPES D'ABONNEMENT - VUES
         ========================================== -->

    <record id="view_residence_membership_type_form" model="ir.ui.view">
        <field name="name">residence.membership.type.form</field>
        <field name="model">residence.membership.type</field>
        <field name="arch" type="xml">
            <form string="Type d'Abonnement">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'abonnement"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="code"/>
                            <field name="external_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Tarification">
                            <field name="price"/>
                            <field name="duration_type"/>
                            <field name="duration_months" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="Avantages">
                        <group>
                            <field name="discount_percentage"/>
                            <field name="free_reservation_hours"/>
                        </group>
                        <group>
                            <field name="priority_booking"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_residence_membership_type_list" model="ir.ui.view">
        <field name="name">residence.membership.type.list</field>
        <field name="model">residence.membership.type</field>
        <field name="arch" type="xml">
            <list string="Types d'Abonnement">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="duration_type"/>
                <field name="discount_percentage"/>
                <field name="priority_booking"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_residence_membership_types" model="ir.actions.act_window">
        <field name="name">Types d'Abonnement</field>
        <field name="res_model">residence.membership.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier type d'abonnement
            </p>
        </field>
    </record>

    <!-- ==========================================
         ABONNEMENTS - VUES
         ========================================== -->

    <record id="view_residence_subscription_form" model="ir.ui.view">
        <field name="name">residence.member.subscription.form</field>
        <field name="model">residence.member.subscription</field>
        <field name="arch" type="xml">
            <form string="Abonnement">
                <header>
                    <button name="action_activate" type="object"
                            string="Activer" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_sale_order" type="object"
                            string="Créer Devis" class="btn-secondary"
                            invisible="sale_order_id"/>
                    <button name="action_cancel" type="object"
                            string="Annuler" class="btn-secondary"
                            invisible="state in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Membre">
                            <field name="partner_id"/>
                            <field name="membership_type_id"/>
                        </group>
                        <group string="Période">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="auto_renew"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montant">
                            <field name="amount"/>
                        </group>
                        <group string="Documents">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="external_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_residence_subscription_list" model="ir.ui.view">
        <field name="name">residence.member.subscription.list</field>
        <field name="model">residence.member.subscription</field>
        <field name="arch" type="xml">
            <list string="Abonnements"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'draft'"
                  decoration-danger="state in ('expired', 'cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="membership_type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state in ('expired', 'cancelled')"/>
                <field name="auto_renew"/>
            </list>
        </field>
    </record>

