<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         LOGS WEBHOOK - VUES
         ========================================== -->

    <record id="view_residence_webhook_log_form" model="ir.ui.view">
        <field name="name">residence.webhook.log.form</field>
        <field name="model">residence.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Log Webhook" create="0" edit="0">
                <header>
                    <button name="action_retry" type="object"
                            string="Relancer" class="btn-primary"
                            invisible="direction != 'outgoing' or state != 'failed'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informations">
                            <field name="direction"/>
                            <field name="event_type"/>
                            <field name="entity_type"/>
                            <field name="entity_id"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-warning="state == 'processing'"
                                   decoration-danger="state == 'failed'"/>
                        </group>
                        <group string="Traitement">
                            <field name="create_date"/>
                            <field name="processed_date"/>
                            <field name="processing_time"/>
                            <field name="attempt_count" invisible="direction != 'outgoing'"/>
                            <field name="next_retry" invisible="direction != 'outgoing'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Headers" name="headers">
                            <field name="headers" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Réponse" name="response">
                            <group>
                                <field name="response_status"/>
                            </group>
                            <field name="response_body" readonly="1"/>
                        </page>
                        <page string="Erreur" name="error" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_residence_webhook_log_list" model="ir.ui.view">
        <field name="name">residence.webhook.log.list</field>
        <field name="model">residence.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Logs Webhook" create="0" edit="0"
                  decoration-success="state == 'success'"
                  decoration-warning="state == 'processing'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'ignored'">
                <field name="create_date"/>
                <field name="direction"/>
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_id"/>
                <field name="response_status"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'processing'"
                       decoration-danger="state == 'failed'"/>
                <field name="processing_time"/>
            </list>
        </field>
    </record>

