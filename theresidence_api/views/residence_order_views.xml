<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         COMMANDES RESTAURANT - VUES
         ========================================== -->

    <!-- Vue formulaire -->
    <record id="view_residence_order_form" model="ir.ui.view">
        <field name="name">residence.order.form</field>
        <field name="model">residence.order</field>
        <field name="arch" type="xml">
            <form string="Commande Restaurant">
                <header>
                    <button name="action_submit" type="object"
                            string="Soumettre" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object"
                            string="Confirmer" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_start_preparation" type="object"
                            string="En Préparation" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_mark_ready" type="object"
                            string="Prête" class="btn-success"
                            invisible="state not in ('confirmed', 'preparing')"/>
                    <button name="action_complete" type="object"
                            string="Terminée" class="btn-success"
                            invisible="state != 'ready'"/>
                    <button name="action_cancel" type="object"
                            string="Annuler" class="btn-secondary"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Remettre en brouillon" class="btn-secondary"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,confirmed,preparing,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id"/>
                            <field name="mode"/>
                            <field name="qr_token" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="ordered_date"/>
                            <field name="confirmed_date" readonly="1"/>
                            <field name="ready_date" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="estimated_prep_time" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="mode != 'delivery'">
                        <field name="delivery_address" placeholder="Adresse de livraison"/>
                    </group>

                    <notebook>
                        <page string="Articles" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" 
                                           domain="[('product_tmpl_id.is_residence_menu_item', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="preparation_state" widget="badge"
                                           decoration-info="preparation_state == 'pending'"
                                           decoration-warning="preparation_state == 'preparing'"
                                           decoration-success="preparation_state == 'ready'"/>
                                    <field name="notes"/>
                                </list>
                            </field>

                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes pour la commande"/>
                            <field name="cancellation_reason" readonly="1"
                                   invisible="state != 'cancelled'"/>
                        </page>

                        <page string="Informations" name="info">
                            <group>
                                <group>
                                    <field name="external_id" readonly="1"/>
                                    <field name="sale_order_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_residence_order_list" model="ir.ui.view">
        <field name="name">residence.order.list</field>
        <field name="model">residence.order</field>
        <field name="arch" type="xml">
            <list string="Commandes Restaurant"
                  decoration-info="state == 'pending'"
                  decoration-warning="state in ('confirmed', 'preparing')"
                  decoration-success="state == 'ready'"
                  decoration-muted="state in ('completed', 'cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="ordered_date"/>
                <field name="estimated_prep_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state in ('confirmed', 'preparing')"
                       decoration-success="state == 'ready'"
                       decoration-muted="state in ('completed', 'cancelled')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="view_residence_order_search" model="ir.ui.view">
        <field name="name">residence.order.search</field>
        <field name="model">residence.order</field>
        <field name="arch" type="xml">
            <search string="Rechercher Commandes">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="qr_token"/>
                <filter name="filter_today" string="Aujourd'hui"
                        domain="[('ordered_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('ordered_date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter name="filter_draft" string="Brouillon"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="En attente"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_active" string="En cours"
                        domain="[('state', 'in', ('confirmed', 'preparing'))]"/>
                <filter name="filter_ready" string="Prêtes"
                        domain="[('state', '=', 'ready')]"/>
                <filter name="filter_completed" string="Terminées"
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="filter_pickup" string="À emporter"
                        domain="[('mode', '=', 'pickup')]"/>
                <filter name="filter_delivery" string="Livraison"
                        domain="[('mode', '=', 'delivery')]"/>
                <filter name="filter_onsite" string="Sur place"
                        domain="[('mode', '=', 'onsite')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_mode" string="Mode"
                            context="{'group_by': 'mode'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'ordered_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Kanban (Cuisine) -->
    <record id="view_residence_order_kanban" model="ir.ui.view">
        <field name="name">residence.order.kanban</field>
        <field name="model">residence.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="state"/>
                <field name="amount_total"/>
                <field name="estimated_prep_time"/>
                <field name="ordered_date"/>
                <progressbar field="state" colors='{"pending": "info", "confirmed": "warning", "preparing": "warning", "ready": "success", "completed": "muted", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge rounded-pill"
                                      t-attf-class="#{record.mode.raw_value == 'pickup' ? 'text-bg-primary' : (record.mode.raw_value == 'delivery' ? 'text-bg-warning' : 'text-bg-info')}">
                                    <field name="mode"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <div class="mt-1">
                                    <span class="text-muted">Prépa: </span>
                                    <field name="estimated_prep_time"/> min
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="ordered_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong><field name="amount_total" widget="monetary"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action principale -->
    <record id="action_residence_orders" model="ir.actions.act_window">
        <field name="name">Commandes Restaurant</field>
        <field name="res_model">residence.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_residence_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune commande
            </p>
        </field>
    </record>

    <!-- Action: Cuisine -->
    <record id="action_residence_orders_kitchen" model="ir.actions.act_window">
        <field name="name">Cuisine</field>
        <field name="res_model">residence.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'in', ('pending', 'confirmed', 'preparing', 'ready'))]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_residence_order_search"/>
    </record>

</odoo>
