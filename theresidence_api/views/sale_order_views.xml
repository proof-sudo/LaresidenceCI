<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         SALE.ORDER (RÉSERVATIONS) - VUES
         ========================================== -->

    <!-- Extension vue formulaire -->
    <record id="view_sale_order_form_residence" model="ir.ui.view">
        <field name="name">sale.order.form.residence</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter onglet Réservation -->
            <xpath expr="//notebook" position="inside">
                <page string="Réservation" name="residence_reservation"
                      invisible="not is_residence_reservation">
                    <group>
                        <group string="Informations Réservation">
                            <field name="residence_external_id" readonly="1"/>
                            <field name="residence_space_id" readonly="1"/>
                            <field name="residence_start_time"/>
                            <field name="residence_end_time"/>
                            <field name="residence_guest_count"/>
                        </group>
                        <group string="Statut">
                            <field name="residence_reservation_status"/>
                            <field name="residence_calendar_event_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="residence_notes" placeholder="Notes pour la réservation"/>
                        <field name="residence_rejection_reason" 
                               invisible="residence_reservation_status != 'rejected'"
                               readonly="1"/>
                    </group>

                    <group string="Invités">
                        <field name="residence_invitee_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

            <!-- Boutons de workflow -->
            <xpath expr="//header" position="inside">
                <button name="action_approve_reservation" type="object"
                        string="Approuver" class="btn-primary"
                        invisible="not is_residence_reservation or residence_reservation_status != 'pending'"/>
                <button name="action_reject_reservation" type="object"
                        string="Rejeter" class="btn-secondary"
                        invisible="not is_residence_reservation or residence_reservation_status != 'pending'"/>
                <button name="action_checkin_reservation" type="object"
                        string="Check-in" class="btn-primary"
                        invisible="not is_residence_reservation or residence_reservation_status != 'approved'"/>
                <button name="action_complete_reservation" type="object"
                        string="Terminer" class="btn-primary"
                        invisible="not is_residence_reservation or residence_reservation_status not in ('approved', 'checked_in')"/>
                <button name="action_cancel_reservation" type="object"
                        string="Annuler Réservation" class="btn-secondary"
                        invisible="not is_residence_reservation or residence_reservation_status in ('completed', 'cancelled')"/>
            </xpath>

            <!-- Badge statut -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_residence_reservation" invisible="1"/>
                <field name="residence_reservation_status" widget="badge"
                       invisible="not is_residence_reservation"
                       decoration-info="residence_reservation_status == 'pending'"
                       decoration-success="residence_reservation_status in ('approved', 'checked_in', 'completed')"
                       decoration-danger="residence_reservation_status in ('rejected', 'cancelled')"/>
            </xpath>
        </field>
    </record>

    <!-- Vue liste réservations -->
    <record id="view_sale_order_list_reservations" model="ir.ui.view">
        <field name="name">sale.order.list.reservations</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Réservations" decoration-info="residence_reservation_status == 'pending'"
                  decoration-success="residence_reservation_status in ('approved', 'checked_in')"
                  decoration-muted="residence_reservation_status in ('completed', 'cancelled')"
                  decoration-danger="residence_reservation_status == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="residence_space_id"/>
                <field name="residence_start_time"/>
                <field name="residence_end_time"/>
                <field name="residence_guest_count"/>
                <field name="residence_reservation_status" widget="badge"
                       decoration-info="residence_reservation_status == 'pending'"
                       decoration-success="residence_reservation_status in ('approved', 'checked_in', 'completed')"
                       decoration-danger="residence_reservation_status in ('rejected', 'cancelled')"/>
                <field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>

