    <!-- Vue calendrier réservations -->
    <record id="view_sale_order_calendar_reservations" model="ir.ui.view">
        <field name="name">sale.order.calendar.reservations</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <calendar string="Réservations" date_start="residence_start_time" 
                      date_stop="residence_end_time" color="residence_space_id"
                      mode="week" event_open_popup="true">
                <field name="partner_id"/>
                <field name="residence_space_id"/>
                <field name="residence_reservation_status"/>
            </calendar>
        </field>
    </record>

    <!-- Action: Liste des réservations -->
    <record id="action_residence_reservations" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,kanban</field>
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field name="context">{'default_is_rental_order': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_sale_order_list_reservations')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_sale_order_calendar_reservations')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})]"/>
        <!-- <field name="search_view_id" ref="view_sale_order_search_reservations"/> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune réservation
            </p>
        </field>
    </record>

</odoo>
