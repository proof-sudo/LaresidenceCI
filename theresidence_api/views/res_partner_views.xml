    <!-- Action: Liste des membres -->
    <record id="action_residence_members" model="ir.actions.act_window">
        <field name="name">Membres</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_residence_member', '=', True)]</field>
        <field name="context">{'default_is_residence_member': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list_residence_members')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="search_view_id" ref="view_partner_search_residence_members"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier membre
            </p>
        </field>
    </record>

