<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         TYPES D'ABONNEMENT PAR DÉFAUT
         ========================================== -->

    <!-- Type: Standard -->
    <record id="membership_type_standard" model="residence.membership.type">
        <field name="name">Standard</field>
        <field name="code">STANDARD</field>
        <field name="sequence">10</field>
        <field name="description">Abonnement de base avec accès aux espaces communs</field>
        <field name="price">50000</field>
        <field name="duration_type">monthly</field>
        <field name="discount_percentage">0</field>
        <field name="free_reservation_hours">0</field>
        <field name="priority_booking" eval="False"/>
    </record>

    <!-- Type: Premium -->
    <record id="membership_type_premium" model="residence.membership.type">
        <field name="name">Premium</field>
        <field name="code">PREMIUM</field>
        <field name="sequence">20</field>
        <field name="description">Abonnement premium avec réductions et avantages</field>
        <field name="price">100000</field>
        <field name="duration_type">monthly</field>
        <field name="discount_percentage">10</field>
        <field name="free_reservation_hours">2</field>
        <field name="priority_booking" eval="False"/>
    </record>

    <!-- Type: Gold -->
    <record id="membership_type_gold" model="residence.membership.type">
        <field name="name">Gold</field>
        <field name="code">GOLD</field>
        <field name="sequence">30</field>
        <field name="description">Abonnement Gold avec accès prioritaire et réductions importantes</field>
        <field name="price">200000</field>
        <field name="duration_type">monthly</field>
        <field name="discount_percentage">20</field>
        <field name="free_reservation_hours">5</field>
        <field name="priority_booking" eval="True"/>
    </record>

    <!-- Type: Platinum (Annuel) -->
    <record id="membership_type_platinum" model="residence.membership.type">
        <field name="name">Platinum</field>
        <field name="code">PLATINUM</field>
        <field name="sequence">40</field>
        <field name="description">Abonnement Platinum annuel avec tous les avantages</field>
        <field name="price">2000000</field>
        <field name="duration_type">yearly</field>
        <field name="discount_percentage">30</field>
        <field name="free_reservation_hours">20</field>
        <field name="priority_booking" eval="True"/>
    </record>

    <!-- Type: Corporate -->
    <record id="membership_type_corporate" model="residence.membership.type">
        <field name="name">Corporate</field>
        <field name="code">CORPORATE</field>
        <field name="sequence">50</field>
        <field name="description">Abonnement entreprise avec accès multi-utilisateurs</field>
        <field name="price">500000</field>
        <field name="duration_type">monthly</field>
        <field name="discount_percentage">15</field>
        <field name="free_reservation_hours">10</field>
        <field name="priority_booking" eval="True"/>
    </record>

</odoo>
