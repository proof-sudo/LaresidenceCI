<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         SÉQUENCES
         ========================================== -->

    <!-- Séquence: Commandes Restaurant -->
    <record id="sequence_residence_order" model="ir.sequence">
        <field name="name">Commande Restaurant The Residence</field>
        <field name="code">residence.order</field>
        <field name="prefix">RO-%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Séquence: Abonnements -->
    <record id="sequence_residence_subscription" model="ir.sequence">
        <field name="name">Abonnement The Residence</field>
        <field name="code">residence.member.subscription</field>
        <field name="prefix">SUB-%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
