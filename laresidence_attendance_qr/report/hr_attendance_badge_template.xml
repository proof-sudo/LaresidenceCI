<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Hérite du badge original Odoo — ajoute le QR après le poste, retire le barcode -->
<template id="print_employee_badge_qr" inherit_id="hr.print_employee_badge">

    <!-- Injection du QR après la ligne du poste -->
    <xpath expr="//tr[td/div/span[@t-out='employee.job_id.name']]" position="after">
        <tr>
            <td align="center" style="padding-top:4pt;">
                <t t-if="employee.attendance_qr_image">
                    <img t-att-src="image_data_uri(employee.attendance_qr_image)"
                         style="max-height:65pt; max-width:90%;"
                         alt="QR Code"/>
                </t>
            </td>
        </tr>
    </xpath>

    <!-- Suppression du barcode -->
    <xpath expr="//tr[td/div[@t-if='employee.barcode']]" position="replace"/>

</template>

</odoo>
