<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_badge_cr80" model="report.paperformat">
        <field name="name">Badge CR80 (85.6 x 54 mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">54</field>
        <field name="page_width">86</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_attendance_badge" model="ir.actions.report">
        <field name="name">Badge Presence QR</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">laresidence_attendance_qr.report_attendance_badge_document</field>
        <field name="report_file">laresidence_attendance_qr.report_attendance_badge_document</field>
        <field name="print_report_name">'Badge - ' + object.name</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="laresidence_attendance_qr.paperformat_badge_cr80"/>
    </record>

</odoo>
