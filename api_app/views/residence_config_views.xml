<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================
         CONFIGURATION API - VUES
         ========================================== -->

    <!-- Vue formulaire -->
    <record id="view_residence_config_form" model="ir.ui.view">
        <field name="name">residence.config.form</field>
        <field name="model">residence.config</field>
        <field name="arch" type="xml">
            <form string="Configuration API">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="test_external_connection" type="object"
                                string="Tester Connexion" class="oe_stat_button" icon="fa-plug"/>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notre API (Mobile → Odoo)" name="internal_api">
                            <group>
                                <group string="Authentification">
                                    <field name="internal_api_key" password="True"/>
                                    <button name="generate_new_api_key" type="object"
                                            string="Générer nouvelle clé" class="btn-secondary"/>
                                </group>
                                <group string="Webhooks">
                                    <field name="webhook_secret" password="True"/>
                                    <button name="generate_new_webhook_secret" type="object"
                                            string="Générer nouveau secret" class="btn-secondary"/>
                                    <field name="webhook_url" widget="CopyClipboardChar"/>
                                </group>
                            </group>
                        </page>

                        <page string="API Externe (Odoo → Mobile)" name="external_api">
                            <group>
                                <group string="Connexion">
                                    <field name="api_base_url"/>
                                    <field name="api_key" password="True"/>
                                </group>
                                <group string="Webhooks Sortants">
                                    <field name="send_webhook_on_change"/>
                                    <field name="external_webhook_url"
                                           invisible="not send_webhook_on_change"/>
                                </group>
                            </group>
                        </page>

                        <page string="Comportement" name="behavior">
                            <group>
                                <group string="Réservations">
                                    <field name="auto_confirm_reservation"/>
                                </group>
                                <group string="Commandes">
                                    <field name="auto_confirm_order"/>
                                </group>
                            </group>
                        </page>

                        <page string="Catégories par défaut" name="defaults">
                            <group>
                                <group>
                                    <field name="default_space_categ_id"/>
                                    <field name="default_menu_categ_id"/>
                                </group>
                                <group>
                                    <field name="default_pricelist_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_residence_config_list" model="ir.ui.view">
        <field name="name">residence.config.list</field>
        <field name="model">residence.config</field>
        <field name="arch" type="xml">
            <list string="Configurations API">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_residence_config" model="ir.actions.act_window">
        <field name="name">Configuration API</field>
        <field name="res_model">residence.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez l'API The Residence
            </p>
        </field>
    </record>

</odoo>
