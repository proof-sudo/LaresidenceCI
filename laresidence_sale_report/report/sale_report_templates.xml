<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_laresidence"
              inherit_id="sale.report_saleorder_document"
              name="La Résidence — Devis enrichi">

        <!--
            ================================================================
            1. EN-TÊTE SOCIÉTÉ : RCCM, email, téléphone sous le logo
            ================================================================
            On injecte les infos société (RCCM, email, tel) au DÉBUT de la
            page, dans la colonne de gauche, juste avant le titre du devis.
            Cela les positionne visuellement sous le bloc logo/nom de société.
            Note : ne pas utiliser company_details car ce dernier place le
            contenu à droite du logo dans le layout standard Odoo 19.
        -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="row mb-4">
                <div class="col-6">
                    <div style="font-size: 12px; line-height: 1.8;">
                        <t t-if="doc.company_id.company_registry">
                            <div>RCCM : <strong t-esc="doc.company_id.company_registry"/></div>
                        </t>
                        <t t-if="doc.company_id.email">
                            <div><t t-esc="doc.company_id.email"/></div>
                        </t>
                        <t t-if="doc.company_id.phone">
                            <div><t t-esc="doc.company_id.phone"/></div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>

        <!--
            ================================================================
            2. COORDONNÉES BANCAIRES avant les totaux
            ================================================================
            Bloc bancaire dynamique (lit le 1er compte bancaire de la société).
            Placé dans sa propre ligne avant les totaux, colonne gauche (col-7).
            Les totaux restent dans leur largeur native (aucune modification
            des classes Bootstrap des totaux → pas de troncature).
        -->
        <xpath expr="//div[@id='total']" position="before">
            <div class="row mb-0 mt-3">
                <div class="col-7">
                    <h6 class="fw-bold mb-2" style="text-decoration: underline; font-size: 12px;">
                        Modalités et conditions de règlement :
                    </h6>
                    <t t-if="doc.company_id.bank_ids">
                        <t t-set="bank" t-value="doc.company_id.bank_ids[0]"/>
                        <p class="mb-1" style="font-size: 12px;">
                            <strong>Par virement bancaire :</strong>
                        </p>
                        <t t-if="bank.bank_id and bank.bank_id.bic">
                            <p class="mb-1" style="font-size: 12px;">
                                Code B.I.C : <strong t-esc="bank.bank_id.bic"/>
                            </p>
                        </t>
                        <p class="mb-1" style="font-size: 12px;">
                            Code I.B.A.N : <strong t-esc="bank.acc_number"/>
                        </p>
                        <p class="mb-0" style="font-size: 12px;">
                            Par chèque à l'ordre de : <strong t-esc="doc.company_id.name"/>
                        </p>
                    </t>
                    <t t-else="">
                        <p class="text-muted mb-0" style="font-size: 12px; font-style: italic;">
                            Configurer un compte bancaire dans la fiche société.
                        </p>
                    </t>
                </div>
            </div>
        </xpath>

        <!--
            ================================================================
            3. CLAUSE LÉGALE DE VENTE après les totaux
            ================================================================
        -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-3">
                <div class="col-12 text-center">
                    <p class="fw-bold mb-0" style="font-size: 12px;">
                        Toute commande est soumise à l'acceptation préalable de nos conditions générales de vente.
                    </p>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
