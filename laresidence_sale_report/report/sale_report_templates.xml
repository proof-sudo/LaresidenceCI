<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ================================================================
        TEMPLATE 1 — Layout : RCCM, email, téléphone SOUS le logo
        ================================================================
        On hérite du layout standard Odoo pour ajouter les infos société
        (RCCM, email, tél) directement sous l'image du logo, dans la
        colonne gauche de l'en-tête. Cela s'applique à tous les rapports
        de la société (devis, factures, bons de livraison…).

        La variable `company` est disponible dans web.external_layout_standard
        et contient les champs de la fiche société (company_registry, email, phone).
    -->
    <template id="external_layout_standard_laresidence"
              inherit_id="web.external_layout_standard"
              name="La Résidence — En-tête avec RCCM">

        <xpath expr="//img[@t-att-src='image_data_uri(company.logo)']" position="after">
            <div t-if="company.company_registry or company.email or company.phone"
                 style="font-size: 11px; line-height: 1.7; margin-top: 4px;">
                <div t-if="company.company_registry">
                    RCCM : <t t-esc="company.company_registry"/>
                </div>
                <div t-if="company.email">
                    <t t-esc="company.email"/>
                </div>
                <div t-if="company.phone">
                    <t t-esc="company.phone"/>
                </div>
            </div>
        </xpath>

    </template>


    <!--
        ================================================================
        TEMPLATE 2 — Rapport de devis : coordonnées bancaires + clause légale
        ================================================================
    -->
    <template id="report_saleorder_document_laresidence"
              inherit_id="sale.report_saleorder_document"
              name="La Résidence — Devis enrichi">

        <!--
            Coordonnées bancaires dans leur propre ligne, AVANT les totaux.
            Lit le 1er compte bancaire configuré sur la fiche société.
            Les totaux restent dans leur largeur native — plus de troncature.
        -->
        <xpath expr="//div[@id='total']" position="before">
            <div class="row mb-0 mt-3">
                <div class="col-7">
                    <h6 class="fw-bold mb-2" style="text-decoration: underline; font-size: 12px;">
                        Modalités et conditions de règlement :
                    </h6>
                    <t t-if="doc.company_id.bank_ids">
                        <t t-set="bank" t-value="doc.company_id.bank_ids[0]"/>
                        <p class="mb-1" style="font-size: 12px;">
                            <strong>Par virement bancaire :</strong>
                        </p>
                        <t t-if="bank.bank_id and bank.bank_id.bic">
                            <p class="mb-1" style="font-size: 12px;">
                                Code B.I.C : <strong t-esc="bank.bank_id.bic"/>
                            </p>
                        </t>
                        <p class="mb-1" style="font-size: 12px;">
                            Code I.B.A.N : <strong t-esc="bank.acc_number"/>
                        </p>
                        <p class="mb-0" style="font-size: 12px;">
                            Par chèque à l'ordre de : <strong t-esc="doc.company_id.name"/>
                        </p>
                    </t>
                    <t t-else="">
                        <p class="text-muted mb-0" style="font-size: 12px; font-style: italic;">
                            Configurer un compte bancaire dans la fiche société.
                        </p>
                    </t>
                </div>
            </div>
        </xpath>

        <!--
            Clause légale de vente, après les totaux, centrée en gras.
        -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-3">
                <div class="col-12 text-center">
                    <p class="fw-bold mb-0" style="font-size: 12px;">
                        Toute commande est soumise à l'acceptation préalable de nos conditions générales de vente.
                    </p>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
